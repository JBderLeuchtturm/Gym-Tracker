<?xml version="1.0" encoding="utf-8"?>
<!-- Wochenziele: bis zu vier Messleisten. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/goals_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/goals_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.12"
        android:maxLines="1"
        android:text="Wochenziele"
        android:textAllCaps="true"
        android:textColor="@color/widget_accent"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/goals_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Wochenziele festlegen"
        android:textColor="@color/widget_muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/goal_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/goal_label_1"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="Tage"
                android:textAllCaps="true"
                android:textColor="@color/widget_dim"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/goal_value_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:text="2 / 3"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="3dp">
        <ProgressBar
            android:id="@+id/goal_bar_1"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="66"
            android:progressDrawable="@drawable/widget_progress" />
        <ProgressBar
            android:id="@+id/goal_done_1"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/widget_progress_done"
            android:visibility="gone" />
    </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/goal_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/goal_label_2"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="Minuten"
                android:textAllCaps="true"
                android:textColor="@color/widget_dim"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/goal_value_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:text="120 / 180"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="3dp">
        <ProgressBar
            android:id="@+id/goal_bar_2"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="66"
            android:progressDrawable="@drawable/widget_progress" />
        <ProgressBar
            android:id="@+id/goal_done_2"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/widget_progress_done"
            android:visibility="gone" />
    </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/goal_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/goal_label_3"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="Volumen"
                android:textAllCaps="true"
                android:textColor="@color/widget_dim"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/goal_value_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:text="13,9k / 15,0k"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="3dp">
        <ProgressBar
            android:id="@+id/goal_bar_3"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="92"
            android:progressDrawable="@drawable/widget_progress" />
        <ProgressBar
            android:id="@+id/goal_done_3"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/widget_progress_done"
            android:visibility="gone" />
    </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/goal_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/goal_label_4"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="Muskelgruppen"
                android:textAllCaps="true"
                android:textColor="@color/widget_dim"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/goal_value_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:text="6 / 15"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="3dp">
        <ProgressBar
            android:id="@+id/goal_bar_4"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="40"
            android:progressDrawable="@drawable/widget_progress" />
        <ProgressBar
            android:id="@+id/goal_done_4"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/widget_progress_done"
            android:visibility="gone" />
    </FrameLayout>
    </LinearLayout>
</LinearLayout>
