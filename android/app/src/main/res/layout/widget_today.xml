<?xml version="1.0" encoding="utf-8"?>
<!-- Heute-Training. Die Beispieltexte erscheinen in der Widget-Auswahl. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/today_label"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Heute"
            android:textAllCaps="true"
            android:textColor="@color/widget_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:maxLines="1" />
        <TextView
            android:id="@+id/today_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="8/20"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/today_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-condensed"
        android:maxLines="1"
        android:text="Push"
        android:textAllCaps="true"
        android:textColor="@color/widget_text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp">
        <ProgressBar
            android:id="@+id/today_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="40"
            android:progressDrawable="@drawable/widget_progress" />
        <ProgressBar
            android:id="@+id/today_progress_done"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/widget_progress_done"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/today_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Bankdrücken (Langhantel)"
        android:textColor="@color/widget_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/today_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Satz 3 von 4 · 82,5 kg × 8"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />
</LinearLayout>
