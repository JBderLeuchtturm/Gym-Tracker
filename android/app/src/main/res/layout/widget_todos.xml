<?xml version="1.0" encoding="utf-8"?>
<!-- To-dos heute: bis zu fuenf Zeilen, der Rest als "+n weitere". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/todos_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/todos_label"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="To-dos heute"
            android:textAllCaps="true"
            android:textColor="@color/widget_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:maxLines="1" />
        <TextView
            android:id="@+id/todos_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="7"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/todos_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Nichts mehr für heute"
        android:textColor="@color/widget_muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/todo_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/todo_dot_1"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="9dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot" />
        <TextView
            android:id="@+id/todo_title_1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Protein-Shake mitnehmen"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/todo_meta_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:text="07:30"
            android:textColor="@color/widget_dim"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/todo_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/todo_dot_2"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="9dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot" />
        <TextView
            android:id="@+id/todo_title_2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Trainingsplan anpassen"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/todo_meta_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/widget_dim"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/todo_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/todo_dot_3"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="9dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot" />
        <TextView
            android:id="@+id/todo_title_3"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Physio anrufen"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/todo_meta_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:text="überfällig"
            android:textColor="@color/widget_dim"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/todo_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/todo_dot_4"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="9dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot" />
        <TextView
            android:id="@+id/todo_title_4"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Wasser 3 Liter"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/todo_meta_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/widget_dim"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/todo_row_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/todo_dot_5"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="9dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot" />
        <TextView
            android:id="@+id/todo_title_5"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Schuhe kaufen"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/todo_meta_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/widget_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/todos_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="+2 weitere"
        android:textColor="@color/widget_dim"
        android:textSize="12sp" />
</LinearLayout>
