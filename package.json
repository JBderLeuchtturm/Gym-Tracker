{
  "name": "gym-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Persoenlicher Gym-Tracker: Wochenplaene, Trainings-Logging, Fortschritts-Charts und Kalorienverbrauch.",
  "scripts": {
    "dev": "npm run catalog && vite",
    "catalog": "node scripts/build-catalog.mjs",
    "prebuild": "node scripts/build-catalog.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "test:build": "npm run build && node tests/run.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@supabase/supabase-js": "^2.115.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.49.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
